<mxfile host="app.diagrams.net" modified="2025-01-01T00:00:00.000Z" agent="5.0" version="22.0.0" etag="dns-ebpf-flow" type="device">
  <diagram name="DNS eBPF traffic &amp; problem" id="dns-ebpf-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="DNS traffic flow: kprobe path and where unparseable happens" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- ========== USERSPACE (top) ========== -->
        <mxCell id="us-label" value="USERSPACE (process in container or host)" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="320" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="Application (nslookup, CoreDNS, etc.)&#xa;Process has DNS query/response in its buffer&#xa;(user virtual address, e.g. stack or heap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="user-buf" value="User buffer (256 bytes)&#xa;DNS payload lives HERE&#xa;Address = user VA (process context)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="syscall-line" value="sendmsg(sock, msghdr) / recvmsg(...)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="158" width="180" height="20" as="geometry"/>
        </mxCell>

        <!-- ========== SYSCALL BOUNDARY ========== -->
        <mxCell id="boundary" value="━━━━━━━━ SYSCALL BOUNDARY ━━━━━━━━" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="182" width="320" height="24" as="geometry"/>
        </mxCell>

        <!-- ========== KERNEL: network stack entry ========== -->
        <mxCell id="kern-label" value="KERNEL" style="text;html=1;strokeColor=none;fillColor=#e1d5e7;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="212" width="320" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="udp-sendmsg" value="udp_sendmsg(sk, msg)&#xa;inet_sendmsg() → udp_sendmsg()&#xa;msg→msg_iter points to user buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="242" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="msghdr" value="struct msghdr&#xa;  msg_iter (struct iov_iter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="240" y="242" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- ========== KPROBE HOOK ========== -->
        <mxCell id="kprobe-box" value="KPROBE (eBPF hook)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="320" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="kprobe-func" value="kprobe__udp_sendmsg(ctx, sk, msg)&#xa;current = process that called sendmsg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="332" width="200" height="44" as="geometry"/>
        </mxCell>

        <!-- ========== eBPF: read iter ========== -->
        <mxCell id="step1" value="1. bpf_probe_read_kernel(&amp;iter, sizeof(iter), &amp;msg→msg_iter)&#xa;   → STEP_SEND_ITER_OK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="384" width="320" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="iov-iter" value="struct iov_iter (in kernel)&#xa;  iter_type @ offset 0 (UBUF=0, IOVEC=1)&#xa;  iov_offset @ 8&#xa;  union @ 24 or 16 → pointer to user buf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="426" width="320" height="52" as="geometry"/>
        </mxCell>

        <!-- ========== get_data_ptr_from_iter ========== -->
        <mxCell id="step2" value="2. get_data_ptr_from_iter(&amp;iter, &amp;iter_type)&#xa;   read iter_type @ IOV_ITER_ITER_TYPE_OFF (0)&#xa;   extract_data_ptr_from_iter_union(iter, type, 24 or 16)&#xa;   validate with 2-byte probe → ptr_primary_probe_ok / ptr_fallback_probe_ok&#xa;   → STEP_SEND_PTR_OK or STEP_SEND_PTR_NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="484" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="data-ptr" value="data_ptr = pointer to&#xa;USER buffer (same VA&#xa;as in process)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="370" y="500" width="100" height="54" as="geometry"/>
        </mxCell>

        <!-- ========== READ PAYLOAD - PROBLEM ZONE ========== -->
        <mxCell id="problem-zone" value="⚠ PROBLEM ZONE (container)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="562" width="320" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="step3" value="3. read_dns_payload(event.dns_data, 256, data_ptr, ...)&#xa;   First: bpf_probe_read_user(dst, 256, data_ptr)&#xa;   → On HOST: OK (user_ok++, STEP_SEND_READ_USER) ✓&#xa;   → In CONTAINER: FAIL (user namespace / context) ✗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="594" width="320" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="step3b" value="   Fallback: bpf_probe_read_kernel(dst, 256, data_ptr)&#xa;   → data_ptr is USER VA: kernel returns WRONG memory&#xa;   (e.g. zero page, other mapping) → garbage in event.dns_data&#xa;   → STEP_SEND_READ_KERNEL (read “succeeds” but content wrong)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="656" width="320" height="58" as="geometry"/>
        </mxCell>

        <!-- ========== Event and perf ========== -->
        <mxCell id="event" value="struct dns_event&#xa;  dns_data[256] = payload or garbage&#xa;  data_len = 256 or 0&#xa;  pid, saddr, daddr, dns_id, ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="200" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="perf-submit" value="events.perf_submit(ctx, &amp;event)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="260" y="730" width="100" height="36" as="geometry"/>
        </mxCell>

        <!-- ========== Network stack (parallel path) ========== -->
        <mxCell id="stack-label" value="Network stack (after kprobe returns): copy from user → skb → IP → UDP → NIC" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="242" width="380" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="stack" value="Later: kernel copies user buffer into skb&#xa;(normal path; we don't read from skb)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="268" width="280" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== USERSPACE: Python ========== -->
        <mxCell id="py-label" value="USERSPACE (dns-monitor pod)" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="788" width="320" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="perf-buf" value="Perf buffer (kernel → user)&#xa;event copy to userspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="818" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="handle-event" value="handle_event(cpu, data, size)&#xa;event.dns_data, event.data_len" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="864" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="parse" value="parse_dns_name(payload, offset=12)&#xa;If payload is garbage → fails&#xa;domain = &quot;&lt;unparseable&gt;&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="910" width="140" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="result-ok" value="HOST: real DNS bytes&#xa;→ domain parsed ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="864" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="result-fail" value="CONTAINER: garbage&#xa;→ &lt;unparseable&gt; ✗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="918" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== UDP RECV path (compact) ========== -->
        <mxCell id="recv-label" value="UDP RECV path (same idea): kprobe__udp_recvmsg saves data_ptr in recv_ctx_map; kretprobe__udp_recvmsg calls read_dns_payload → same user/kernel read issue" style="text;html=1;strokeColor=none;fillColor=#e1d5e7;align=left;verticalAlign=middle;fontSize=10;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="320" width="380" height="36" as="geometry"/>
        </mxCell>

        <!-- ========== Legend ========== -->
        <mxCell id="leg-title" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="380" width="60" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg1" value="User buffer / iov_iter (data lives in process)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="400" width="260" height="24" as="geometry"/>
