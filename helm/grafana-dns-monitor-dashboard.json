{
  "annotations": { "list": [] },
  "description": "eBPF DNS monitor. Labels: client_pod = pod that generated the DNS event (traffic source). direction = query|response. Prometheus drops pod/exported_pod via metricRelabelings so only client_pod is used.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(dns_queries_total[5m])) by (protocol)", "legendFormat": "{{protocol}}", "refId": "A" }
      ],
      "title": "DNS queries rate (by protocol)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(dns_responses_total[5m])) by (protocol)", "legendFormat": "{{protocol}}", "refId": "A" }
      ],
      "title": "DNS responses rate (by protocol)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(dns_suspicious_total[5m])) by (threat_type)", "legendFormat": "{{threat_type}}", "refId": "A" }
      ],
      "title": "Suspicious DNS (by threat_type). Empty = no suspicious traffic yet",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": {},
      "targets": [
        { "expr": "sum(dns_domains_unique)", "legendFormat": "Unique domains", "refId": "A" }
      ],
      "title": "Unique domains (gauge)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(dns_events_by_pod_total[5m])) by (client_pod)", "legendFormat": "{{client_pod}}", "refId": "A" }
      ],
      "title": "DNS events by client pod (traffic source)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(dns_events_by_process_total[5m])) by (process, client_pod)", "legendFormat": "{{process}} @ {{client_pod}}", "refId": "A" }
      ],
      "title": "DNS events by process + client pod",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(dns_events_by_pod_total{direction=\"query\"}[5m])) by (client_pod)", "legendFormat": "{{client_pod}}", "refId": "A" }
      ],
      "title": "DNS queries by client pod only (who made the request; filters out CoreDNS responses on master)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["dns", "ebpf", "security"],
  "templating": {
    "list": [
      { "current": {}, "hide": 0, "includeAll": false, "multi": false, "name": "datasource", "options": [], "query": "prometheus", "refresh": 1, "regex": "", "skipUrlSync": false, "type": "datasource" }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
